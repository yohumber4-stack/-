{
  "name": "the-long-road",
  "version": "1.0.0",
  "private": true,
  "description": "Single-file 3D desert road-trip survival game in the spirit of The Long Drive",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "release": "node tools/build.mjs && cp dist/index.html TheLongRoad.html",
    "dev": "node tools/serve.mjs --watch",
    "serve": "node tools/serve.mjs",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "three": "^0.186.0",
    "typescript": "5.9"
  }
}
